107 RCDATA "@CMAKE_CURRENT_SOURCE_DIR@/third_party/licenses/nlohmann-json.LICENSE.txt"
108 RCDATA "@CMAKE_CURRENT_SOURCE_DIR@/third_party/licenses/Roboto.LICENSE.txt"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "OpenReverse Community\0"
            VALUE "FileDescription", "OpenReverse Setup\0"
            VALUE "FileVersion", "@OPENREVERSE_VERSION@\0"
            VALUE "InternalName", "OpenReverse Setup\0"
            VALUE "LegalCopyright", "Copyright (c) 2026 OpenReverse contributors\0"
            VALUE "OriginalFilename", "OpenReverse-@OPENREVERSE_VERSION@-Setup.exe\0"
            VALUE "ProductName", "OpenReverse\0"
            VALUE "ProductVersion", "@OPENREVERSE_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
