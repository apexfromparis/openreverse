#include <windows.h>
1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/installer/openreverse.ico"
101 RCDATA "@OPENREVERSE_INSTALLER_PAYLOAD@"
@OPENREVERSE_DIA_RESOURCE_LINE@
103 RCDATA "@CMAKE_CURRENT_SOURCE_DIR@/LICENSE"
104 RCDATA "@CMAKE_CURRENT_SOURCE_DIR@/THIRD_PARTY_NOTICES.md"
